# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to client code — never put
# secrets here that aren't meant to be public.

# Backend API base URL (falls back to the production URL in vibeApi.ts if unset)
VITE_API_BASE_URL=https://vibegarage-backend.onrender.com

# Web Push — VAPID PUBLIC key only. This is safe to expose client-side;
# that's what it's for. Generated for this project on 2026-06-20 via
# `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=BKoAHagrg25z9_duPGSIK0Abxi-8MwxMJ_0ID-os70JoxUX_8pw79Q9r2q4Zrfg61UV69w1zUxkyiT1vg5DkDWM

# The matching PRIVATE key goes on the backend ONLY, as a server-side env
# var (e.g. VAPID_PRIVATE_KEY) — never in this file, never shipped to the
# client. It is:
#   z54puHCsrE2Fl22Na_zrJEfsBvn2vQUJHQXHMdBXjM0
# Rotate both keys if the private key is ever committed or shared insecurely.
